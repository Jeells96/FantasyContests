rules_version = '2';

/**
 * Fantasy Contests security rules — open, no authentication required.
 *
 * This app uses no Firebase Authentication: players are identified by a random
 * id generated on their own device, and the admin PIN is checked in the
 * browser. Nothing needs enabling in the Firebase console beyond Firestore.
 *
 * WHAT THIS MEANS: anyone who has the project's web config (it ships in the
 * JavaScript bundle, as it must) can read and write this database directly.
 * The admin PIN keeps the default settings out of casual reach, not out of a
 * determined one.
 *
 * Anyone can start a contest. A contest belongs to the device that created it,
 * and it is reached by its six-digit join code: nothing in the app lists every
 * contest, so a player only sees the ones they started or joined. Ownership and
 * membership are enforced in the app, not here, because there is no login for
 * the rules to check a device id against.
 *
 * Two contest rules are still enforced here, because they need no login:
 *   - lineups and picks freeze when the contest locks, so a submitted entry
 *     cannot be edited once the first game has started;
 *   - entries cannot be listed before lock, so other players' rosters and picks
 *     cannot be pulled down in bulk while the contest is still open. Reading one
 *     entry requires already knowing its random device id.
 *
 * For a completely open database, replace everything inside the documents match
 * with:
 *
 *   match /{document=**} {
 *     allow read, write: if true;
 *   }
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /** The whole contest locks when its first game is scheduled to begin. */
    function contestLocked(contestId) {
      let contest = get(/databases/$(database)/documents/contests/$(contestId)).data;
      return contest.keys().hasAny(['lockAt']) && request.time >= contest.lockAt;
    }

    match /contests/{contestId} {
      allow read, write: if true;

      // Player pool: salaries, projections and live statistics.
      match /pool/{chunkId} {
        allow read, write: if true;
      }

      // Public entrant records: a name and a submitted flag, never a roster.
      match /standings/{entryId} {
        allow read, write: if true;
      }

      // Lineups and game-winner picks.
      match /entries/{entryId} {
        // A player reads their own entry by its id, which only their device knows.
        allow get: if true;
        // Listing every entry is what would otherwise expose the whole field
        // before anyone has locked in.
        allow list: if contestLocked(contestId);
        // Entries become immutable the moment the contest locks.
        allow create, update: if !contestLocked(contestId);
        allow delete: if true;
      }
    }

    match /config/{document} {
      allow read, write: if true;
    }
  }
}
