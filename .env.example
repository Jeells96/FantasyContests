# Firebase web config. The values below are the defaults compiled into the app
# (src/lib/firebase.ts) — override them here to point at a different project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SportsGameOdds API key, used to capture the betting line when a contest is
# created. A default is compiled in; set this to use a different key.
VITE_SPORTSGAMEODDS_KEY=

# Admin PIN. This app uses no Firebase Authentication: the PIN is compared in the
# browser, so it gates the admin screens but is not a server-side check.
VITE_ADMIN_PIN=2325
