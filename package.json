{
  "name": "fantasy-contests",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first daily fantasy contest platform for NFL, MLB and NBA with cross-sport score normalization",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "live-sync": "esbuild scripts/live-sync.ts --bundle --platform=node --format=cjs --target=node20 --outfile=scripts/.build/live-sync.cjs --log-level=error && node scripts/.build/live-sync.cjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "npm run build && firebase deploy",
    "check:engine": "esbuild scripts/engine-check.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.build/engine-check.mjs --log-level=warning && node scripts/.build/engine-check.mjs",
    "backfill:codes": "esbuild scripts/backfill-join-codes.ts --bundle --platform=node --format=cjs --target=node20 --outfile=scripts/.build/backfill-join-codes.cjs --log-level=error && node scripts/.build/backfill-join-codes.cjs",
    "check:cfb": "esbuild scripts/cfb-check.ts --bundle --platform=node --format=cjs --target=node20 --outfile=scripts/.build/cfb-check.cjs --log-level=error && node scripts/.build/cfb-check.cjs",
    "check:mlb": "esbuild scripts/mlb-check.ts --bundle --platform=node --format=cjs --target=node20 --outfile=scripts/.build/mlb-check.cjs --log-level=error && node scripts/.build/mlb-check.cjs"
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
