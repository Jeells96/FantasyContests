# Firebase web config. The values below are the defaults compiled into the app
# (src/lib/firebase.ts) — override them here to point at a different project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin account used to satisfy the Firestore admin security rules.
# The admin UI asks for the PIN only; the PIN is combined with the salt below to
# derive the password of this Firebase Auth account. Both must match the account
# you create in the Firebase console (see README "Admin bootstrap").
VITE_ADMIN_EMAIL=admin@fantasycontests.app
VITE_ADMIN_PW_SALT=fc-admin-v1
